# Gutfit Brand OS Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Public URL for the application
PUBLIC_URL=http://localhost:8056

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
DB_PASSWORD=gutfit123

# =============================================================================
# DIRECTUS CONFIGURATION
# =============================================================================

# Directus Admin User
ADMIN_EMAIL=admin@gutfit.com
ADMIN_PASSWORD=gutfit123

# Directus Secret (change in production!)
SECRET=gutfit-super-secret-key-change-in-production

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Password
REDIS_PASSWORD=gutfit123

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# AI Model Provider (openai, anthropic, cohere)
AI_MODEL_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# AI Configuration
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
GPU_ENABLED=false

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=gutfit123

# =============================================================================
# GUTFIT-SPECIFIC CONFIGURATION
# =============================================================================

# Gutfit Brand Configuration
GUTFIT_BRAND_NAME=Gutfit
GUTFIT_BRAND_TAGLINE=Your Gut, Your Health, Your Life
GUTFIT_BRAND_CATEGORY=Health & Wellness

# Scientific Updates Configuration
GUTFIT_SCIENTIFIC_UPDATE_FREQUENCY=quarterly
GUTFIT_MEDICAL_REVIEW_REQUIRED=true

# Health Content Configuration
GUTFIT_HEALTH_CLAIMS_VALIDATION=true
GUTFIT_SCIENTIFIC_REFERENCES_REQUIRED=true

# =============================================================================
# FEATURES CONFIGURATION
# =============================================================================

# Enable AI Features
ENABLE_AI_FEATURES=true

# Enable Scientific Updates
ENABLE_SCIENTIFIC_UPDATES=true

# Enable Health Analytics
ENABLE_HEALTH_ANALYTICS=true

# Enable Brand Book Generation
ENABLE_BRAND_BOOK_GENERATION=true

# Enable Asset Generation
ENABLE_ASSET_GENERATION=true

# =============================================================================
# BETA V1.0 CONFIGURATION
# =============================================================================

# Beta Mode
BETA_MODE=true
BETA_VERSION=1.0.0

# Beta Features
ENABLE_BETA_FEATURES=true
ENABLE_EXPERIMENTAL_FEATURES=false

# Beta Analytics
ENABLE_BETA_ANALYTICS=true
BETA_FEEDBACK_COLLECTION=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret (change in production!)
JWT_SECRET=gutfit-jwt-secret-change-in-production

# Encryption Key (32 characters, change in production!)
DB_ENCRYPTION_KEY=gutfit-encryption-key-32-chars

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# Rate Limit Window (in milliseconds)
RATE_LIMIT_WINDOW=900000

# Rate Limit Max Requests
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache TTL (in seconds)
CACHE_TTL=3600

# Cache Max Size
CACHE_MAX_SIZE=1000

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@gutfit.com

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================

# Webhook URL
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Webhook Secret
WEBHOOK_SECRET=gutfit-webhook-secret

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Retention Days
BACKUP_RETENTION_DAYS=30

# Backup Schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Max File Size (in bytes)
MAX_FILE_SIZE=104857600

# Request Timeout (in milliseconds)
REQUEST_TIMEOUT=30000

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable hot reload in development
HOT_RELOAD=true

# Enable debug mode
DEBUG=false

# =============================================================================
# PRODUCTION CONFIGURATION (uncomment for production)
# =============================================================================

# NODE_ENV=production
# LOG_LEVEL=warn
# HOT_RELOAD=false
# DEBUG=false

# Use HTTPS in production
# PUBLIC_URL=https://gutfit.juicc.com
# CORS_ORIGIN=https://app.gutfit.com

# =============================================================================
# CLIENT DELIVERY CONFIGURATION
# =============================================================================

# Client Name
CLIENT_NAME=Gutfit

# Client Domain
CLIENT_DOMAIN=gutfit.juicc.com

# Delivery Mode (demo, staging, production)
DELIVERY_MODE=demo

# Client Contact
CLIENT_CONTACT_EMAIL=client@gutfit.com
CLIENT_CONTACT_NAME=Gutfit Team

# =============================================================================
# DISPLAY CONFIGURATION
# =============================================================================

# Display Brand Logo
DISPLAY_BRAND_LOGO=true

# Display Brand Colors
DISPLAY_BRAND_COLORS=true

# Display Scientific Content
DISPLAY_SCIENTIFIC_CONTENT=true

# Display Health Metrics
DISPLAY_HEALTH_METRICS=true

# =============================================================================
# DEMO CONFIGURATION
# =============================================================================

# Enable Demo Mode
DEMO_MODE=true

# Demo Data
DEMO_DATA_SAMPLE_BRAND_BOOK=true
DEMO_DATA_SAMPLE_ASSETS=true
DEMO_DATA_SCIENTIFIC_UPDATES=true

# Demo Features
DEMO_FEATURE_AI_CHAT=true
DEMO_FEATURE_BRAND_BOOK_GENERATION=true
DEMO_FEATURE_HEALTH_ANALYTICS=true