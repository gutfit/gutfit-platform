# Juicc Brand OS Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Public URL for the application
PUBLIC_URL=http://localhost:8055

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
DB_PASSWORD=juicc123

# =============================================================================
# DIRECTUS CONFIGURATION
# =============================================================================

# Directus Admin User
ADMIN_EMAIL=admin@juicc.com
ADMIN_PASSWORD=juicc123

# Directus Secret (change in production!)
SECRET=juicc-super-secret-key-change-in-production

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Password
REDIS_PASSWORD=juicc123

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# AI Model Provider (openai, anthropic, cohere)
AI_MODEL_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# AI Configuration
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
GPU_ENABLED=false

# =============================================================================
# SOCIAL MEDIA API CONFIGURATION
# =============================================================================

# Twitter API
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Facebook API
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Instagram API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# LinkedIn API
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=juicc123

# =============================================================================
# NEO4J CONFIGURATION
# =============================================================================

# Neo4j Password
NEO4J_PASSWORD=juicc123

# =============================================================================
# SSL CONFIGURATION (for production)
# =============================================================================

# SSL Certificate Path
SSL_CERT_PATH=./ssl/cert.pem

# SSL Private Key Path
SSL_KEY_PATH=./ssl/key.pem

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable hot reload in development
HOT_RELOAD=true

# Enable debug mode
DEBUG=false

# =============================================================================
# PRODUCTION CONFIGURATION (uncomment for production)
# =============================================================================

# NODE_ENV=production
# LOG_LEVEL=warn
# HOT_RELOAD=false
# DEBUG=false

# Use HTTPS in production
# PUBLIC_URL=https://direct.gutfit.co
# CORS_ORIGIN=https://app.gutfit.co

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Retention Days
BACKUP_RETENTION_DAYS=30

# Backup Schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Max File Size (in bytes)
MAX_FILE_SIZE=104857600

# Request Timeout (in milliseconds)
REQUEST_TIMEOUT=30000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret (change in production!)
JWT_SECRET=juicc-jwt-secret-change-in-production

# Encryption Key (32 characters, change in production!)
DB_ENCRYPTION_KEY=juicc-encryption-key-32-chars

# =============================================================================
# FEATURES CONFIGURATION
# =============================================================================

# Enable AI Features
ENABLE_AI_FEATURES=true

# Enable Social Media Integration
ENABLE_SOCIAL_MEDIA=true

# Enable Analytics
ENABLE_ANALYTICS=true

# Enable Brand Book Generation
ENABLE_BRAND_BOOK_GENERATION=true

# Enable Asset Generation
ENABLE_ASSET_GENERATION=true

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# Rate Limit Window (in milliseconds)
RATE_LIMIT_WINDOW=900000

# Rate Limit Max Requests
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache TTL (in seconds)
CACHE_TTL=3600

# Cache Max Size
CACHE_MAX_SIZE=1000

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@juicc.com

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================

# Webhook URL
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Webhook Secret
WEBHOOK_SECRET=juicc-webhook-secret