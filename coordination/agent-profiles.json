  "coordination_algorithms": {
    "task_assignment": {
      "method": "Weighted Capability Matching",
      "factors": [
        "expertise_score",
        "work_pattern_compatibility",
        "current_load",
        "historical_performance"
      ],
      "conflict_resolution": "skill_portfolio_similarity"
    },

    "work_load_balancing": {
      "metric": "active_tasks_per_agent",
      "threshold_high": 3,
      "threshold_critical": 5,
      "auto_reassignment": true
    },

    "communication_triggers": {
      "file_change_events": true,
      "task_status_updates": true,
      "agent_availability_changes": true,
      "conflict_detection": true
    }
  },

  "emergency_protocols": {
    "single_agent_failure": {
